# ── 필수 ───────────────────────────────────────────
# 최초 기동 시 admin 계정 비밀번호(최초 로그인 후 변경 강제). 비우면 data/INITIAL_ADMIN_PASSWORD.txt 에 무작위 생성
KPAA_ADMIN_PASSWORD=
# HTTPS 뒤에서 운영하면 1
KPAA_COOKIE_SECURE=0

# ── 선택: AI 보조(근거 제한 분석·녹취 요약·사례 추출) ──
# 설정하지 않으면 규칙·검색 기반 기능만 동작합니다.
ANTHROPIC_API_KEY=
KPAA_AI_MODEL=claude-opus-5-5
KPAA_AI_EFFORT=high

# ── 선택: 공문 메일 발송(SMTP) ──────────────────────
KPAA_SMTP_HOST=
KPAA_SMTP_PORT=587
KPAA_SMTP_USER=
KPAA_SMTP_PASSWORD=
KPAA_SMTP_FROM=
KPAA_SMTP_STARTTLS=1
KPAA_SMTP_BCC_SELF=1

# ── 운영 ───────────────────────────────────────────
KPAA_SESSION_HOURS=10
KPAA_MAX_UPLOAD_MB=200
KPAA_BACKUP_KEEP=30
